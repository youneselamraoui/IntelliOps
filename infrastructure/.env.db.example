# ===== vm-prod-db / vm-staging-db =====

# vm-prod-db : intelliops_prod   |   vm-staging-db : intelliops_staging
DB_DATABASE=intelliops_prod
DB_USERNAME=intelliops
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_PORT=5432
# IP de la carte réseau PRIVÉE (VMnet) de cette VM, pas celle du NAT, pas 0.0.0.0
DB_BIND_IP=CHANGE_ME_IP_VMNET

# Version testée de dpage/pgadmin4
PGADMIN_VERSION=9.17
PGADMIN_EMAIL=admin@intelliops.ma
PGADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PGADMIN_PORT=5050
# Local à la VM : accès par tunnel SSH (ssh -L 5050:127.0.0.1:5050 user@IP_VM)
PGADMIN_BIND_IP=127.0.0.1