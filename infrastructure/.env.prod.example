# ===== vm-prod =====
# Usage : docker compose -f docker-compose.yml -f infrastructure/docker-compose.prod.yml --env-file infrastructure/.env.prod up -d --build
# Évite le caractère $ dans les valeurs.

# Laravel
APP_NAME=IntelliOps
APP_ENV=production
APP_KEY=base64:GENERER_AVEC_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=http://IP_VM_PROD
# Migrations au démarrage : true seulement le temps d'un déploiement qui en contient
RUN_MIGRATIONS=false

# Base de données (sur vm-prod-db) : IP VMnet de vm-prod-db
# DB_DATABASE / DB_USERNAME / DB_PASSWORD identiques à ceux de .env.db de vm-prod-db
DB_CONNECTION=pgsql
DB_HOST=IP_VMNET_VM_PROD_DB
DB_PORT=5432
DB_DATABASE=intelliops_prod
DB_USERNAME=intelliops
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Frontend : valeurs figées AU BUILD (relancer avec --build si elles changent)
VITE_API_URL=/api
VITE_KEYCLOAK_URL=http://IP_VM_PROD:8082

# Keycloak (base "keycloak" à créer sur vm-prod-db)
# Même version majeure que les données existantes
KEYCLOAK_VERSION=26.8.1
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
KC_HOSTNAME=http://IP_VM_PROD:8082
KC_DB_NAME=keycloak

# Monitoring (versions testées)
PROMETHEUS_VERSION=v3.14.0
GRAFANA_VERSION=13.3.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD