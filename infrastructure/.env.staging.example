# ===== vm-staging =====
# Fichier utilisé à la fois par --env-file (interpolation) et par env_file du backend.
# Évite le caractère $ dans les valeurs.

# Laravel (APP_ENV=staging est forcé par le compose)
APP_NAME=IntelliOps
APP_KEY=base64:GENERER_AVEC_ARTISAN_KEY_GENERATE
APP_URL=http://IP_VM_STAGING:8080
RUN_MIGRATIONS=true

# Base de données (sur vm-staging-db) : IP VMnet de vm-staging-db
# DB_DATABASE / DB_USERNAME / DB_PASSWORD identiques à ceux de .env.db de vm-staging-db
DB_CONNECTION=pgsql
DB_HOST=IP_VMNET_VM_STAGING_DB
DB_PORT=5432
DB_DATABASE=intelliops_staging
DB_USERNAME=intelliops
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Frontend : valeurs figées AU BUILD
VITE_API_URL=/api
VITE_KEYCLOAK_URL=http://IP_VM_STAGING:8082

# Keycloak (base "keycloak" à créer sur vm-staging-db)
KEYCLOAK_VERSION=26.8.1
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
KC_DB_NAME=keycloak

# Versions testées des images (SonarQube : tag de l'édition community)
KEYCLOAK_VERSION=26.8.1
JENKINS_VERSION=2.580.2-lts-jdk21
SONARQUBE_VERSION=26.10.0.133078-community
TRIVY_VERSION=0.76.1
ZAP_VERSION=2.17.0
PROMETHEUS_VERSION=v3.14.0
GRAFANA_VERSION=13.3.1

# Outils
ZAP_API_KEY=CHANGE_ME_STRONG_KEY
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD