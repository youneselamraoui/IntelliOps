# Généré par Ansible : ne pas éditer à la main
APP_NAME=IntelliOps
APP_KEY={{ app_key }}
APP_URL=http://{{ ips[inventory_hostname] }}:8080
RUN_MIGRATIONS=true

DB_CONNECTION=pgsql
DB_HOST={{ ips[db_host] }}
DB_PORT=5432
DB_DATABASE=intelliops_staging
DB_USERNAME={{ db_user }}
DB_PASSWORD={{ db_password }}

VITE_API_URL=/api
VITE_KEYCLOAK_URL=http://{{ ips[inventory_hostname] }}:8082

KEYCLOAK_VERSION={{ keycloak_version }}
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD={{ keycloak_admin_password }}
KC_DB_NAME=keycloak

JENKINS_VERSION={{ jenkins_version }}
SONARQUBE_VERSION={{ sonarqube_version }}
TRIVY_VERSION={{ trivy_version }}
ZAP_VERSION={{ zap_version }}
PROMETHEUS_VERSION={{ prometheus_version }}
GRAFANA_VERSION={{ grafana_version }}

ZAP_API_KEY={{ zap_api_key }}
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}

MONITORING_BIND_IP={{ ips[inventory_hostname] }}