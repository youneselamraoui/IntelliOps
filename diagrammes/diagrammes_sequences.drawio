 <diagram id="auth-simple" name="Authentification utilisateurs"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=12;" value="Diagramme de séquence – Authentification (Keycloak), création du projet et de l'équipe IntelliOps" vertex="1"><mxGeometry height="30" width="1700" x="20" y="5" as="geometry"/></mxCell><mxCell id="k2" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b&gt;PERSONNE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ADMIN, DEVOPS, SECURITE, DEVELOPPEUR, OBSERVATEUR&lt;/font&gt;" vertex="1"><mxGeometry height="1900" width="160" x="40" y="45" as="geometry"/></mxCell><mxCell id="k3" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;TABLEAU DE BORD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;interface React&lt;/font&gt;" vertex="1"><mxGeometry height="1900" width="160" x="290" y="45" as="geometry"/></mxCell><mxCell id="k4" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="&lt;b&gt;KEYCLOAK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;fournisseur d'identité (externe)&lt;/font&gt;" vertex="1"><mxGeometry height="1900" width="160" x="540" y="45" as="geometry"/></mxCell><mxCell id="k5" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;UTILISATEUR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;email, admin_global, actif, lien Keycloak&lt;/font&gt;" vertex="1"><mxGeometry height="1900" width="160" x="790" y="45" as="geometry"/></mxCell><mxCell id="k6" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;PROJET&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;projets autorisés&lt;/font&gt;" vertex="1"><mxGeometry height="1900" width="160" x="1040" y="45" as="geometry"/></mxCell><mxCell id="k7" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;MEMBRE_PROJET&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rôle, peut_approuver&lt;/font&gt;" vertex="1"><mxGeometry height="1900" width="160" x="1290" y="45" as="geometry"/></mxCell><mxCell id="k8" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="&lt;b&gt;AUDIT_LOG&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;journal non modifiable&lt;/font&gt;" vertex="1"><mxGeometry height="1900" width="160" x="1540" y="45" as="geometry"/></mxCell><mxCell id="k9" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;" value="1. Ouvrir le tableau de bord"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="140" as="sourcePoint"/><mxPoint x="370" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k10" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;" value="2. Rediriger vers la page de connexion"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="205" as="sourcePoint"/><mxPoint x="620" y="205" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k11" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;" value="3. Saisir email et mot de passe"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="270" as="sourcePoint"/><mxPoint x="620" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k12" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;" value="4. Vérifier les identifiants"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="335" as="sourcePoint"/><mxPoint x="620" y="365" as="targetPoint"/><Array as="points"><mxPoint x="710" y="335"/><mxPoint x="710" y="365"/></Array></mxGeometry></mxCell><mxCell id="k13" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=50;height=25;fontStyle=1;fillColor=none;" value="alt" vertex="1"><mxGeometry height="640" width="1700" x="20" y="395" as="geometry"/></mxCell><mxCell id="k14" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=12;" value="[identifiants valides]" vertex="1"><mxGeometry height="24" width="900" x="80" y="400" as="geometry"/></mxCell><mxCell id="k15" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;dashed=1;" value="5. Jeton d'accès (retour vers l'application)"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="450" as="sourcePoint"/><mxPoint x="370" y="450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k16" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;" value="6. Appeler l'API avec le jeton :&lt;br&gt;vérifier le jeton, retrouver ou créer le compte"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="515" as="sourcePoint"/><mxPoint x="870" y="515" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k17" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;" value="7. Chercher les projets autorisés"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="580" as="sourcePoint"/><mxPoint x="1120" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k18" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;dashed=1;" value="8. Liste des projets"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="645" as="sourcePoint"/><mxPoint x="870" y="645" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k19" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;dashed=1;" value="9. Session ouverte (rôles et projets)"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="710" as="sourcePoint"/><mxPoint x="370" y="710" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k20" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;" value="10. Journaliser la connexion"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="775" as="sourcePoint"/><mxPoint x="1620" y="775" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k21" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;dashed=1;" value="11. Afficher le tableau de bord"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="840" as="sourcePoint"/><mxPoint x="120" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k22" edge="1" parent="1" style="html=1;endArrow=none;dashed=1;strokeColor=#666666;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="880" as="sourcePoint"/><mxPoint x="1720" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k23" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=12;" value="[identifiants invalides]" vertex="1"><mxGeometry height="24" width="900" x="80" y="885" as="geometry"/></mxCell><mxCell id="k24" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;dashed=1;" value="12. Message d'erreur : identifiants invalides&lt;br&gt;(après trop d'échecs, le compte est verrouillé)"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="950" as="sourcePoint"/><mxPoint x="120" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k25" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=0;fontSize=12;" value="Jeton absent, invalide ou expiré : l'API répond 401 et le tableau de bord renvoie vers la page de connexion de Keycloak." vertex="1"><mxGeometry height="24" width="1500" x="40" y="1055" as="geometry"/></mxCell><mxCell id="k26" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=50;height=25;fontStyle=1;fillColor=none;" value="opt" vertex="1"><mxGeometry height="700" width="1700" x="20" y="1110" as="geometry"/></mxCell><mxCell id="k27" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=12;" value="[Connecté avec le rôle ADMIN sur le projet : création du projet et de l'équipe — sinon erreur 403]" vertex="1"><mxGeometry height="24" width="1300" x="80" y="1115" as="geometry"/></mxCell><mxCell id="k28" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;" value="13. Saisir le projet : nom, dépôt,&lt;br&gt;application, environnements"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="1220" as="sourcePoint"/><mxPoint x="370" y="1220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k29" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;" value="14. Créer le projet&lt;br&gt;+ environnements (dev, test, production)"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="1285" as="sourcePoint"/><mxPoint x="1120" y="1285" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k30" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;dashed=1;" value="15. Projet créé (id_projet)"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="1350" as="sourcePoint"/><mxPoint x="370" y="1350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k31" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;" value="16. Ajouter les membres : email + rôle&lt;br&gt;(DEVOPS, DEVELOPPEUR, SECURITE, OBSERVATEUR) + peut_approuver"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="1415" as="sourcePoint"/><mxPoint x="370" y="1415" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k32" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;" value="17. Créer ou retrouver le compte du membre&lt;br&gt;(lié à Keycloak)"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="1480" as="sourcePoint"/><mxPoint x="870" y="1480" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k33" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;" value="18. Affecter le membre au projet&lt;br&gt;avec son rôle"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="1545" as="sourcePoint"/><mxPoint x="1370" y="1545" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k34" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;dashed=1;" value="19. Membres enregistrés"><mxGeometry relative="1" as="geometry"><mxPoint x="1370" y="1610" as="sourcePoint"/><mxPoint x="370" y="1610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k35" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;" value="20. Noter la création du projet&lt;br&gt;et de l'équipe dans le journal"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="1675" as="sourcePoint"/><mxPoint x="1620" y="1675" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k36" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=12;labelBackgroundColor=none;dashed=1;" value="21. Confirmer : projet et équipe créés"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="1740" as="sourcePoint"/><mxPoint x="120" y="1740" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k37" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=0;fontSize=12;" value="Les mots de passe sont gérés uniquement par Keycloak ; la plateforme garde les rôles par projet et la permission peut_approuver. Seul un membre avec peut_approuver peut valider une action sensible." vertex="1"><mxGeometry height="40" width="1500" x="40" y="1840" as="geometry"/></mxCell></root></mxGraphModel></diagram>
