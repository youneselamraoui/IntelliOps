        <mxCell id="KFDIdaNCdhTIA6li7b-7-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=4;" value="&lt;b&gt;Note — Adaptateurs (②)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Un adaptateur par type de source (GitLab, Jenkins, SonarQube, Trivy, OWASP ZAP, Docker, K8s, Prometheus, logs Linux) : patterns Adapter + Factory. Ajouter une source revient à ajouter un adaptateur, sans modifier le reste de la chaîne." vertex="1">
          <mxGeometry height="154" width="300" x="925" y="266" as="geometry" />
        </mxCell>
        <mxCell id="KFDIdaNCdhTIA6li7b-7-2" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=4;" value="&lt;b&gt;Note — Validation et quarantaine (⑦, ⑪)&lt;/b&gt;&lt;br&gt;&lt;br&gt;⑦ vérifie le contrat : champs obligatoires, valeurs autorisées (severity, event_type), horodatage au format ISO 8601.&lt;br&gt;&lt;br&gt;Un événement non conforme, ou sans adaptateur (③ = non), est mis en quarantaine avec le motif du rejet, et non perdu silencieusement." vertex="1">
          <mxGeometry height="160" width="300" x="920" y="571" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
